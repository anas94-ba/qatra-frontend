# Base URL of the Qatra API (includes the /api prefix, no trailing slash needed)
# Used by `npm run dev`, and by Docker at container start (docker run --env-file .env / docker compose up)
VITE_API_URL=http://localhost:4000/api

# Optional: Cloudflare Turnstile site key to show the CAPTCHA on registration
VITE_TURNSTILE_SITE_KEY=
